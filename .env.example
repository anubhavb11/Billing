# Local development only: copy to .env (git-ignored) and fill in.
# On Netlify, set these under Site configuration > Environment variables instead.

# Local Postgres, or a Neon connection string (postgresql://...neon.tech/...?sslmode=require).
# Not needed on Netlify when the Neon database is connected there (NETLIFY_DATABASE_URL).
DATABASE_URL=postgresql://localhost:5432/billing_dev

# The PIN typed once on each phone. Use 6 or more digits.
SHOP_PIN=
